# 叩君芯 · 本地开发环境变量模板
# 复制为仓库根目录 .env 后按需修改。不要填入真实密钥，不要提交 .env。
# 用法：
#   copy .env.example .env
#   docker compose --env-file .env -f deploy/compose/docker-compose.dev.yml up -d

# ---------------------------------------------------------------------------
# 通用
# ---------------------------------------------------------------------------
KJX_ENV=dev
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# MySQL 8.4（Compose 建库；应用连接走 DB_*）
# ---------------------------------------------------------------------------
MYSQL_DATABASE=koujunxin
MYSQL_ROOT_PASSWORD=dev-only-mysql-root-change-me
MYSQL_USER=kjx
MYSQL_PASSWORD=dev-only-mysql-kjx-change-me

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=koujunxin
DB_USER=kjx
DB_PASSWORD=dev-only-mysql-kjx-change-me

# ---------------------------------------------------------------------------
# Redis 8
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 宿主机映射端口。6379 已被占用时改为 6380，并让上面的 REDIS_PORT 与它相同。
REDIS_HOST_PORT=6379
REDIS_PASSWORD=dev-only-redis-change-me
REDIS_DATABASE=0

# ---------------------------------------------------------------------------
# 应用端口（本机进程或 Compose profile）
# ---------------------------------------------------------------------------
BACKEND_PORT=8080
WEB_PORT=3000
ADMIN_PORT=3001
NGINX_HTTP_PORT=80

# Docker Nginx 反代上游（默认指向宿主机已发布端口）
BACKEND_UPSTREAM=host.docker.internal:8080
WEB_UPSTREAM=host.docker.internal:3000
ADMIN_UPSTREAM=host.docker.internal:3001

# ---------------------------------------------------------------------------
# 认证 / 加密（假值，仅占位；生产必须轮换且来自密钥管理）
# PHONE_CRYPTO_KEY 需 32 字节，对应 AES-256-GCM
# PHONE_HMAC_SECRET 用于手机号 HMAC-SHA256 索引，禁止改用裸 SHA256
# ---------------------------------------------------------------------------
PHONE_CRYPTO_KEY=dev-only-phone-crypto-key-32byte
PHONE_HMAC_SECRET=dev-only-phone-hmac-secret-do-not-use
SA_TOKEN_JWT_SECRET_KEY=dev-only-satoken-secret-change-me

# ---------------------------------------------------------------------------
# 短信 / 对象存储（M1 可选；假值）
# ---------------------------------------------------------------------------
SMS_ACCESS_KEY_ID=dev-only-not-a-real-key
SMS_ACCESS_KEY_SECRET=dev-only-not-a-real-secret
SMS_SIGN_NAME=DEVONLY
SMS_TEMPLATE_CODE=SMS_000000

OSS_ENDPOINT=https://oss-cn-example.aliyuncs.com
OSS_ACCESS_KEY_ID=dev-only-not-a-real-key
OSS_ACCESS_KEY_SECRET=dev-only-not-a-real-secret
OSS_BUCKET=kjx-dev-bucket
OSS_REGION=cn-example

# ---------------------------------------------------------------------------
# 可选 observability 栈（仅 deploy/observability/docker-compose.yml）
# ---------------------------------------------------------------------------
KJX_CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=dev-only-clickhouse-change-me
CLICKHOUSE_TIMEOUT_MS=2000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-change-me

# 主播部门默认挂载到该根部门
KJX_HOST_ROOT_DEPT_ID=200
