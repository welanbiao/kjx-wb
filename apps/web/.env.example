# 浏览器可读取的公开配置。密钥与 token 不得写入此文件或任何 NEXT_PUBLIC_* 变量。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=叩君芯
NEXT_PUBLIC_APP_VERSION=0.0.0

# 业务请求走同源 BFF（/app/**）。
# 本地开发可设 mock。生产构建未配置时默认 live，不会静默 Mock。
KJX_API_MODE=mock
KJX_API_ORIGIN=http://localhost:8080

# 仅测试/验收显式打开「模拟审核」与验证码测试替身。生产必须为 false 或省略。
NEXT_PUBLIC_ENABLE_MOCK_TOOLS=true
