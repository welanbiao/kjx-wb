{
  "description": "WP-10 前端 Mock 示例。图形验证码走 tianai-captcha GET /captcha/gen（非本冻结清单）。token 放入 httpOnly Cookie，禁止 localStorage。",
  "sendCode": {
    "method": "POST",
    "path": "/app/auth/send-code",
    "headers": {
      "X-Idempotency-Key": "11111111-1111-1111-1111-111111111111",
      "X-Device-Id": "web-chrome-01",
      "X-Client-Version": "1.0.0"
    },
    "body": {
      "phone": "13800138000",
      "scene": "register",
      "captchaId": "tianai-challenge-id",
      "captchaData": { "x": 120, "track": [] }
    },
    "response": { "code": 0, "data": { "expireIn": 300 }, "msg": "", "requestId": "01JMOCKREQUEST0001" }
  },
  "register": {
    "path": "/app/auth/register",
    "body": {
      "phone": "13800138000",
      "password": "Abcd1234",
      "code": "123456",
      "agreeTerms": true
    },
    "response": { "code": 0, "data": { "token": "<sa-token app>", "accountId": 1 } }
  },
  "login": {
    "path": "/app/auth/login",
    "body": { "phone": "13800138000", "password": "Abcd1234" },
    "response": {
      "code": 0,
      "data": {
        "token": "<sa-token app>",
        "expireIn": 2592000,
        "account": { "id": 1, "nickname": "用户8000", "avatar": null, "phoneMask": "138****8000" },
        "bindStatus": 0,
        "member": null
      }
    }
  },
  "loginByCode": {
    "path": "/app/auth/login-by-code",
    "body": { "phone": "13800138000", "code": "123456" }
  },
  "devices": {
    "path": "GET /app/account/devices",
    "note": "响应禁止包含 token 或 token_hash"
  },
  "cancel": {
    "path": "POST /app/account/cancel",
    "body": { "code": "123456", "reason": "" },
    "revoke": "POST /app/account/cancel/revoke （冷静期内撤销，待合入总 OpenAPI）"
  }
}
